{
  "name": "pi-freeflow",
  "type": "module",
  "version": "1.38.5",
  "description": "Thin provider for OMP/Pi — model list + dumb relay proxy + log; host pi-ai owns thinking/normalization",
  "main": "extensions/index.ts",
  "types": "src/index.ts",
  "keywords": [
    "pi-package",
    "pi-extension",
    "oh-my-pi",
    "omp",
    "free-models",
    "opencode",
    "kilocode",
    "ai-models",
    "relay"
  ],
  "author": "trefeon",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trefeon/pi-freeflow.git"
  },
  "homepage": "https://github.com/trefeon/pi-freeflow#readme",
  "engines": {
    "node": ">=22.19.0"
  },
  "omp": {
    "extensions": [
      "./extensions"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions"
    ]
  },
  "files": [
    "extensions",
    "src",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --import ./test/setup.mjs --test --test-concurrency=1 test/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types -e \"import('./extensions/index.ts').then(() => console.log('✓ Smoke test passed: extensions/index.ts loaded successfully')).catch(err => { console.error(err); process.exit(1); })\"",
    "changeset": "changeset",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.13.9",
    "js-yaml": "^5.5.0",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.4"
  },
  "dependencies": {
    "undici": "7.30.1"
  }
}
